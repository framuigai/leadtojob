# Copy to .env and fill in. .env is NEVER committed.
# Every key present here must be present there; a missing one fails loudly at
# boot in production (app/__init__.py::_check_required_config).

# --- Flask ------------------------------------------------------------------
FLASK_ENV=development
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
# Paste the OUTPUT, never the command. See _check_required_config for why.
FLASK_SECRET_KEY=

# --- Database ---------------------------------------------------------------
# Local development: a local Postgres 16. NEVER SQLite — the schema uses ARRAY,
# JSONB, a computed column and a partial unique index, none of which SQLite has.
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@127.0.0.1:5433/jobsat_dev

# A SEPARATE database. The test fixture calls drop_all(); pointed at the line
# above it would destroy the dev data, and pointed at production, everything.
# tests/conftest.py refuses to run if this equals DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@127.0.0.1:5433/jobsat_test

# --- Canonical public origin ------------------------------------------------
# Every anonymous survey link is built from this, NOT from the request's Host
# header. An admin browsing *.onrender.com must still copy links that say
# jobs.leadto.co.ke. Production refuses to boot on a localhost value.
SURVEY_BASE_URL=http://localhost:5000

# --- Anthropic (phase 8+; narrative generation only) ------------------------
ANTHROPIC_API_KEY=

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=DEBUG
LOG_TO_FILE=True
LOG_TO_STDERR=True

# --- Seed accounts (local development only) ---------------------------------
# seed_admin.py refuses a published default password outside development.
SEED_ADMIN_EMAIL=admin@jobs.dev
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Master Admin
